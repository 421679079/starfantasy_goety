{
  "meta": {
    "format_version": "5.0",
    "model_format": "free",
    "box_uv": false
  },
  "name": "apostle_the_cruel",
  "model_identifier": "geometry.apostle_the_cruel",
  "visible_box": [
    4,
    6,
    4
  ],
  "variable_placeholders": "",
  "multi_file_ruleset": "",
  "variable_placeholder_buttons": [],
  "timeline_setups": [],
  "unhandled_root_fields": {
    "source_format": "OptiFine/EMF CEM JEM",
    "source_file": "assets/goety/optifine/cem/apostle.jem",
    "source_pack": "Apostle T-fix10",
    "source_author": "4911",
    "license": "GNU General Public License v3.0",
    "conversion_note": "Direct JEM conversion followed by semantic variant separation; no retained cube was redesigned, decimated, or merged.",
    "legacy_cem_animations": [
      {
        "model_path": "model[1]",
        "bone": "body",
        "animations": [
          {
            "adult.ty": 0,
            "a_body.ry": "head.ry * 0.3",
            "a_skirt1.rx": 0,
            "a_head.rx": "head.rx",
            "a_head.ry": "head.ry",
            "a_head.rz": "head.rz",
            "longlong.rx": "0.5*limb_speed - head.rx",
            "a_armL.rx": "if(right_arm.visible, 0, left_leg.rx) + left_arm.rx",
            "a_armR.rx": "if(right_arm.visible, 0, right_leg.rx) + right_arm.rx",
            "a_armL.rz": "-0.3 + left_arm.rz",
            "a_armR.rz": "-a_armL.rz",
            "a_armL.ry": "if(right_arm.visible, 0, 0.314)",
            "a_armR.ry": "if(right_arm.visible, 0, -0.314)",
            "a_legL.rx": "left_leg.rx * 0.2",
            "a_legR.rx": "right_leg.rx * 0.2",
            "c1.ry": "0.4 * sin(time * 0.2)",
            "c2.ry": "-0.4 * sin(time * 0.2)"
          }
        ]
      }
    ],
    "semantic_split": {
      "removed_cubes": 181,
      "removed_groups": 63,
      "flattened_unnamed_groups": 2
    },
    "starfantasy_apostle_leg_horizontal_scale": 0.8,
    "starfantasy_variant": {
      "id": "the_cruel",
      "display_name": "Apostle the Cruel / 冷酷寒冬",
      "source": "Apostle_Original_Gecko.bbmodel",
      "changes": [
        "mao hat tree removed recursively",
        "longlong lower 37 terminal bones removed for shoulder-length hair",
        "hair and eyebrows recolored blue-gray",
        "entire a_skirt1 tree hidden but retained for source compatibility",
        "five fitted Pyre Lord shorts cubes copied completely and recolored dark",
        "upper clothing recolored blue",
        "existing sleeve trim and new waist band recolored yellow",
        "shorts cuffs inflated by 0.03 to prevent coplanar side-face Z-fighting",
        "shorts recolored to one solid dark tone without seam lines",
        "light-blue socks painted directly onto the lower-leg texture",
        "shoes recolored dark brown",
        "chest cross replaced by a pale-blue snowflake texture motif",
        "halo recolored with a pale-blue centre-to-edge gradient",
        "coarse torso snowflake replaced by a high-resolution transparent texture decal",
        "slightly raised dark-red cross hairpin added to the character's left fringe",
        "two dark-red hood drawstrings attached beneath the yellow pifeng collar"
      ],
      "resources": {
        "bridge": [
          0,
          64
        ],
        "shorts": [
          16,
          64
        ],
        "cuff": [
          48,
          64
        ],
        "snowflake_decal": [
          80,
          64
        ],
        "cross_hairpin": [
          128,
          64
        ],
        "hood_drawstrings": [
          144,
          64
        ]
      }
    }
  },
  "resolution": {
    "width": 256,
    "height": 512
  },
