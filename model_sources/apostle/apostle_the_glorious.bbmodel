{"meta":{"format_version":"5.0","model_format":"geckolib_model","box_uv":false},"name":"apostle_the_glorious","model_identifier":"geometry.apostle_the_glorious","visible_box":[4,6,4],"variable_placeholders":"","multi_file_ruleset":"","variable_placeholder_buttons":[],"timeline_setups":[],"unhandled_root_fields":{"source_format":"OptiFine/EMF CEM JEM","source_file":"assets/goety/optifine/cem/apostle.jem","source_pack":"Apostle T-fix10","source_author":"4911","license":"GNU General Public License v3.0","conversion_note":"Direct JEM conversion followed by semantic variant separation; no retained cube was redesigned, decimated, or merged.","legacy_cem_animations":[{"model_path":"model[1]","bone":"body","animations":[{"adult.ty":0,"a_body.ry":"head.ry * 0.3","a_skirt1.rx":0,"a_head.rx":"head.rx","a_head.ry":"head.ry","a_head.rz":"head.rz","longlong.rx":"0.5*limb_speed - head.rx","a_armL.rx":"if(right_arm.visible, 0, left_leg.rx) + left_arm.rx","a_armR.rx":"if(right_arm.visible, 0, right_leg.rx) + right_arm.rx","a_armL.rz":"-0.3 + left_arm.rz","a_armR.rz":"-a_armL.rz","a_armL.ry":"if(right_arm.visible, 0, 0.314)","a_armR.ry":"if(right_arm.visible, 0, -0.314)","a_legL.rx":"left_leg.rx * 0.2","a_legR.rx":"right_leg.rx * 0.2","c1.ry":"0.4 * sin(time * 0.2)","c2.ry":"-0.4 * sin(time * 0.2)"}]}],"semantic_split":{"removed_cubes":181,"removed_groups":63,"flattened_unnamed_groups":2},"starfantasy_variant":{"id":"the_glorious","display_name":"荣耀之名","source":"apostle_the_witch_king.bbmodel + apostle_the_cruel.bbmodel + apostle.jem","changes":["witch hat retained but hidden and excluded from export","exact The Cruel short-hair hierarchy","golden glory halo","silver, charcoal, royal-purple and gold knight cuirass","layered symmetrical pauldrons and articulated gauntlets","user-pruned 70-cube skirt geometry preserved without coordinate or rotation changes","skirt recolored royal purple with its former magenta trim converted to gold","hair rebuilt into four brighter blonde-gold shade levels","upper thighs restored to the thin Witch King silhouette and textured as white trousers","lower legs retain original apostle.jem thickness","calves, greaves and shoes unified into one dark-steel armoured-boot material","two silver-purple-gold waist-side armour plates","only cube_71.east and mirrored cube_110.west use the silver-gold-red cross shield texture","gold edging retained on only four world-frontmost skirt side faces","four front skirt gold lines continue through two upper skirt tiers, with matching narrow gold borders painted on their north faces","corrected mirrored north-face gold borders, completed cube_92/94/106, and synchronized coplanar cube_102 with cube_89"],"resource_uvs":{"metal_swatches":[0,96,112,16],"leg_plate":[0,112,32,160],"cuirass":[32,112,64,144],"reserved_tasset":[64,112,80,144],"armoured_boot":[112,96,128,112],"white_trousers":[128,96,144,112],"waist_side_armour":[144,96,160,128],"skirt_shield_steel":[160,96,176,112],"skirt_shield_cross":[160,112,192,144],"skirt_vertical_gold_edges":[48,96,64,112],"front_four_gold_edges":[48,96,64,112],"front_gold_north_both":[0,0,5,5],"front_gold_north_east":[6,0,11,5],"front_gold_north_west":[12,0,17,5],"front_gold_top_both":[0,0,5,5],"front_gold_top_world_west":[6,0,11,5],"front_gold_top_world_east":[12,0,17,5],"front_gold_bottom_both":[18,0,23,5],"front_gold_bottom_world_west":[24,0,29,5],"front_gold_bottom_world_east":[30,0,35,5]},"leg_proportions":{"upper":"thin Witch King silhouette","lower":"original apostle.jem width and depth"},"skirt_shields":{"right":"cube_71.east","left":"cube_110.west","geometry_changed":false},"front_gold_edge_faces":["cube_101.west","cube_104.west","cube_106.west","cube_85.east","cube_85.west","cube_88.east","cube_89.east","cube_89.west","cube_91.east","cube_92.east","cube_92.west","cube_94.east"],"front_gold_north_faces":["cube_101","cube_102","cube_104","cube_106","cube_85","cube_88","cube_89","cube_91","cube_92","cube_94"],"coplanar_gold_partner":"cube_102 mirr