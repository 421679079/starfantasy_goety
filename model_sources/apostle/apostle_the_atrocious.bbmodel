  ],
  "variable_placeholders": "",
  "multi_file_ruleset": "",
  "variable_placeholder_buttons": [],
  "timeline_setups": [],
  "unhandled_root_fields": {
    "source_format": "OptiFine/EMF CEM JEM",
    "source_file": "assets/goety/optifine/cem/apostle.jem",
    "source_pack": "Apostle T-fix10",
    "source_author": "4911",
    "license": "GNU General Public License v3.0",
    "conversion_note": "Direct JEM conversion followed by semantic variant separation; no retained cube was redesigned, decimated, or merged.",
    "legacy_cem_animations": [
      {
        "model_path": "model[1]",
        "bone": "body",
        "animations": [
          {
            "adult.ty": 0,
            "a_body.ry": "head.ry * 0.3",
            "a_skirt1.rx": 0,
            "a_head.rx": "head.rx",
            "a_head.ry": "head.ry",
            "a_head.rz": "head.rz",
            "longlong.rx": "0.5*limb_speed - head.rx",
            "a_armL.rx": "if(right_arm.visible, 0, left_leg.rx) + left_arm.rx",
            "a_armR.rx": "if(right_arm.visible, 0, right_leg.rx) + right_arm.rx",
            "a_armL.rz": "-0.3 + left_arm.rz",
            "a_armR.rz": "-a_armL.rz",
            "a_armL.ry": "if(right_arm.visible, 0, 0.314)",
            "a_armR.ry": "if(right_arm.visible, 0, -0.314)",
            "a_legL.rx": "left_leg.rx * 0.2",
            "a_legR.rx": "right_leg.rx * 0.2",
            "c1.ry": "0.4 * sin(time * 0.2)",
            "c2.ry": "-0.4 * sin(time * 0.2)"
          }
        ]
      }
    ],
    "semantic_split": {
      "removed_cubes": 181,
      "removed_groups": 63,
      "flattened_unnamed_groups": 2
    },
    "starfantasy_apostle_leg_horizontal_scale": 0.8,
    "starfantasy_variant": {
      "id": "the_atrocious",
      "display_name": "Apostle the Atrocious / 十恶不赦",
      "source": "apostle_the_cruel.bbmodel",
      "changes": [
        "derived from Apostle the Cruel while retaining its shoulder-length hairstyle",
        "hair and eyebrows recolored blood red",
        "two small front locks recolored with warm white-peach highlights",
        "dark-red cross hairpin replaced by a seven-part small white flower hairpin",
        "Cruel snowflake decal and hood drawstrings removed",
        "Cruel shorts, cuffs and crotch bridge removed completely",
        "Witch King second a_skirt1 tier copied as the compact sailor-skirt silhouette",
        "all 28 nested source skirt groups retained with their original rotation angles",
        "copied skirt coordinates and rotation pivots compacted and raised together",
        "dark sailor waistband fitted around the raised single-tier waistline",
        "front and rear skirt branches and waistband moved 0.30 blocks inward along Z to close waist gaps",
        "upper clothing recolored pale gray-lavender with dark navy trim",
        "layered navy sailor collar with white piping added to chest and back",
        "purple sailor tie with knot and two hanging tails added",
        "light-blue socks recolored warm white while preserving the shoes",
        "halo recolored to a blue-to-violet radial gradient"
      ],
      "resources": {
        "sailor_skirt": [
          0,
          64
        ],
        "sailor_collar": [
          80,
          64
        ],
        "white_flower": [
          128,
          64
        ]
      }
    }
  },
  "resolution": {
    "width": 256,
    "height": 512
  },
