  },
  "name": "apostle_the_profane",
  "model_identifier": "geometry.apostle_the_profane",
  "visible_box": [
    4,
    6,
    4
  ],
  "variable_placeholders": "",
  "multi_file_ruleset": "",
  "variable_placeholder_buttons": [],
  "timeline_setups": [],
  "unhandled_root_fields": {
    "source_format": "OptiFine/EMF CEM JEM",
    "source_file": "assets/goety/optifine/cem/apostle.jem",
    "source_pack": "Apostle T-fix10",
    "source_author": "4911",
    "license": "GNU General Public License v3.0",
    "conversion_note": "Direct JEM conversion followed by semantic variant separation; no retained cube was redesigned, decimated, or merged.",
    "legacy_cem_animations": [
      {
        "model_path": "model[1]",
        "bone": "body",
        "animations": [
          {
            "adult.ty": 0,
            "a_body.ry": "head.ry * 0.3",
            "a_skirt1.rx": 0,
            "a_head.rx": "head.rx",
            "a_head.ry": "head.ry",
            "a_head.rz": "head.rz",
            "longlong.rx": "0.5*limb_speed - head.rx",
            "a_armL.rx": "if(right_arm.visible, 0, left_leg.rx) + left_arm.rx",
            "a_armR.rx": "if(right_arm.visible, 0, right_leg.rx) + right_arm.rx",
            "a_armL.rz": "-0.3 + left_arm.rz",
            "a_armR.rz": "-a_armL.rz",
            "a_armL.ry": "if(right_arm.visible, 0, 0.314)",
            "a_armR.ry": "if(right_arm.visible, 0, -0.314)",
            "a_legL.rx": "left_leg.rx * 0.2",
            "a_legR.rx": "right_leg.rx * 0.2",
            "c1.ry": "0.4 * sin(time * 0.2)",
            "c2.ry": "-0.4 * sin(time * 0.2)"
          }
        ]
      }
    ],
    "semantic_split": {
      "removed_cubes": 181,
      "removed_groups": 63,
      "flattened_unnamed_groups": 2
    },
    "starfantasy_apostle_leg_horizontal_scale": 0.8,
    "starfantasy_variant": {
      "id": "the_profane",
      "display_name": "apostle_the_profane",
      "source": "Apostle_Original_Gecko.bbmodel",
      "changes": [
        "original mao hat tree removed recursively",
        "longlong back-hair tree removed for apostle_the_dark short hairstyle",
        "short hair and eyebrows recolored white",
        "black clothing with neutral-gray sleeve trim",
        "neutral-gray trim painted on the lowest skirt hem",
        "original red irises restored",
        "original skin and facial tones retained",
        "halo recolored from white centre to gray outside",
        "old red cross removed from the robe texture",
        "deep V necklace painted as alternating dark/light gray chain links",
        "thin red cross pendant attached to the existing UpperBody bone",
        "white short hair darkened to a cooler light gray for skin contrast",
        "red cross pendant enlarged to twice its planar size without extra thickness",
        "remaining lower skirt panels alpha-cut into irregular torn-cloth edges",
        "all remaining a_skirt1 down-face UVs made transparent so no solid underside caps remain",
        "irregular transparent tear cut into the selected front skirt panel",
        "previous hollow shoulder holes restored to opaque black cloth",
        "cube_80 and its coincident fill layers alpha-cut at one visible torn opening",
        "cube_135 alpha-cut through both faces as a rear skirt hole",
        "both black sleeve shells alpha-cut into irregular cuffs while gray arm cubes remain intact",
        "lower necklace chain links and red cross pendant raised to clear the robe",
        "halo gradient changed from a green core to a dark-green outside",
        "robe and shoes matched in a slightly lighter near-black dark green"
      ]
    }
  },
  "geckolib_modid": "star_fantasy_apostle_models",
  "geckolib_filepath_cache": {},
  "resolution": {
    "width": 256,
