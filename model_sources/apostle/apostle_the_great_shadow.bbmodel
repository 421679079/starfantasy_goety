  ],
  "variable_placeholders": "",
  "multi_file_ruleset": "",
  "variable_placeholder_buttons": [],
  "timeline_setups": [],
  "unhandled_root_fields": {
    "source_format": "OptiFine/EMF CEM JEM",
    "source_file": "assets/goety/optifine/cem/apostle.jem",
    "source_pack": "Apostle T-fix10",
    "source_author": "4911",
    "license": "GNU General Public License v3.0",
    "conversion_note": "Direct JEM conversion followed by semantic variant separation; no retained cube was redesigned, decimated, or merged.",
    "legacy_cem_animations": [
      {
        "model_path": "model[1]",
        "bone": "body",
        "animations": [
          {
            "adult.ty": 0,
            "a_body.ry": "head.ry * 0.3",
            "a_skirt1.rx": 0,
            "a_head.rx": "head.rx",
            "a_head.ry": "head.ry",
            "a_head.rz": "head.rz",
            "longlong.rx": "0.5*limb_speed - head.rx",
            "a_armL.rx": "if(right_arm.visible, 0, left_leg.rx) + left_arm.rx",
            "a_armR.rx": "if(right_arm.visible, 0, right_leg.rx) + right_arm.rx",
            "a_armL.rz": "-0.3 + left_arm.rz",
            "a_armR.rz": "-a_armL.rz",
            "a_armL.ry": "if(right_arm.visible, 0, 0.314)",
            "a_armR.ry": "if(right_arm.visible, 0, -0.314)",
            "a_legL.rx": "left_leg.rx * 0.2",
            "a_legR.rx": "right_leg.rx * 0.2",
            "c1.ry": "0.4 * sin(time * 0.2)",
            "c2.ry": "-0.4 * sin(time * 0.2)"
          }
        ]
      }
    ],
    "semantic_split": {
      "removed_cubes": 181,
      "removed_groups": 63,
      "flattened_unnamed_groups": 2
    },
    "starfantasy_apostle_leg_horizontal_scale": 0.8,
    "starfantasy_variant": {
      "id": "the_great_shadow",
      "display_name": "Apostle the Great Shadow",
      "source": "Apostle_Original_Gecko.bbmodel",
      "changes": [
        "sacred black-and-crimson nun upper clothing",
        "pure-white layered lower skirt",
        "white hair and eyebrows",
        "black over-knee stocking legs",
        "wide hat brim and feather ornament removed",
        "original bone25 face veil retained",
        "small nun cap with a golden cross",
        "two segmented black-and-crimson front cape ribbons",
        "one scaled feathers + threads wing",
        "golden halo",
        "solid white halo restored"
      ],
      "resource_uvs": {
        "wing_atlas": [
          256,
          0
        ],
        "hat_cross": [
          256,
          256
        ],
        "front_ribbon": [
          272,
          256
        ]
      },
      "refinement": {
        "base": "apostle_the_great_shadow.bbmodel",
        "changes": [
          "white halo",
          "brighter white hair",
          "dark-crimson upper clothing with white sleeve cuffs",
          "Apollyon-positioned two-sided cape ribbons with a bright border",
          "correct Bedrock-to-Blockbench wing axis and rotations"
        ]
      },
      "pf_panels": {
        "geometry_source": "model_sources/apollyon/apollyon.bbmodel 中的 pf1 与 pf2 节点",
        "texture_source": "model_sources/apollyon/apollyon.bbmodel 的内嵌贴图，经重新映射与改色",
        "scale": 0.75,
        "copied_descendants": [
          "bone183/bone182/bone146/bone147",
          "bone184/bone181/bone94/bone99",
          "bone98/bone148/bone97/bone92"
        ]
      },
      "chest_cross": {
        "color": "gold",
        "element": "cube_42",
        "face": "north",
        "pixels": 7
      },
      "pf_geometry_policy": {
        "mode": "exact_recursive_copy",
        "staged_depth_offsets": false,
        "note": "Original relative coordinates and rotations preserved"
      },
      "pf_square_patterned_tips": {
        "terminal_bones": [
          "great_shadow_bone147",
          "great_shadow_bone99"
        ],
        "shape": "square",
        "z_rotation": 0.0,
        "motif_source": "short front-panel version, UV 272,304 to 288,320",
        "motif_target": [
          416,
          256,
          432,
          272
        ]
      },
      "pf_rigid_skirt_fit": {
        "angle_x": 7.5,
        "pivot_y": 25.0,
        "pivot_z": -1.225,
        "method": "single rigid transform on complete pf1/pf2 trees",
        "internal_geometry_changed": false,
        "skirt_aabb_intersections_before": 33,
        "skirt_aabb_intersections_after": 0
      }
    }
